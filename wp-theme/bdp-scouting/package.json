{
  "name": "bdp-scouting-theme",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress theme build (bun + Tailwind CSS v4) for the BdP Scouting theme, converted from the bdp_template TYPO3 sitepackage.",
  "type": "module",
  "scripts": {
