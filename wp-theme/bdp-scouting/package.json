  },
  "dependencies": {
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@types/bun": "latest",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3"
  }
}
