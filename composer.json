{
    "name": "pfadfinden/bdp-template",
    "description": "BdP WordPress theme test tooling (Brain Monkey based unit tests, no full WordPress install required).",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": false
    }
}
