{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["Resources/Private/Source/*"],
      "Scss/*": ["Resources/Private/Source/Scss/*"],
      "Images/*": ["Resources/Private/Source/Images/*"],
      "Fonts/*": ["Resources/Private/Source/Fonts/*"]
    }
  },
  "include": [
    "Resources/Private/Source/JavaScript/**/*.ts",
    "types/*.d.ts"
  ]
}
